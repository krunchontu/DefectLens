datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Defect {
  id                    String   @id @default(cuid())
  title                 String
  module                String
  environment           String
  severity              String
  status                String
  expectedResult        String
  actualResult          String
  stepsToReproduce      String
  affectedCaseIds       String
  notes                 String?

  rootCauseCategory     String?
  rootCauseExplanation  String?
  similarRiskAreas      String?
  preventionActions     String?
  preventionProgress    String?
  uatScenarios          String?
  cabSummary            String?
  releaseRisk           String?
  rollbackConsideration String?

  events                DefectEvent[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DefectEvent {
  id        String   @id @default(cuid())
  defectId  String
  type      String
  summary   String
  detail    String?
  createdAt DateTime @default(now())

  defect    Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId])
}
