# Database connection string.
# Local (SQLite) — path is resolved relative to the prisma/ folder:
DATABASE_URL=file:./dev.db
# Production (Postgres) — uncomment and set your connection string:
# DATABASE_URL=postgresql://user:password@host:5432/defectlens

# Optional. If blank, the app uses deterministic mock AI analysis.
OPENAI_API_KEY=

PORT=3001

# Frontend base URL - PRODUCTION ONLY. Leave blank in local dev; the Vite proxy handles /api locally.
VITE_API_BASE_URL=

# Production CORS - set to the deployed Vercel origin on Railway. Ignored in local dev.
CORS_ORIGIN=
